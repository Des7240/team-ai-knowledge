{
  "mcpServers": {
    "team-knowledge-base-local": {
      "command": "node",
      "args": [
        "<YOUR_KB_PATH>/mcp-server/dist/index.js"
      ],
      "env": {
        "KB_ROOT": "<YOUR_KB_PATH>"
      }
    },
    "team-knowledge-base-remote": {
      "type": "streamable-http",
      "serverURL": "https://<YOUR_RENDER_URL>/mcp"
    }
  }
}
